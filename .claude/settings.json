{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/jobs/**)",
      "Edit(/jobs/**)",
      "Read(/output/**)",
      "Edit(/output/**)"
    ],
    "ask": [
      "Edit(/jobs/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(/CLAUDE.md)",
      "Edit(/.gitignore)",
      "Edit(/.claude/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "."
      ],
      "allowWrite": [
        "./jobs",
        "./output"
      ],
      "denyRead": [
        "./.env",
        "./.env.*"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-output.py\""
          }
        ]
      }
    ]
  }
}
